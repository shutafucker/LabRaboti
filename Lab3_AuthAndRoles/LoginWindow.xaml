<Window x:Class="CyberClubApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberArena — Вход" Height="280" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в панель админа"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Логин" Margin="0,0,0,4"/>
            <TextBox x:Name="TbUsername" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PbPassword" Height="28" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="3" Content="Войти" Height="34"
                Click="BtnLogin_Click" IsDefault="True"/>

        <TextBlock Grid.Row="4" x:Name="TbError"
                   Foreground="Red" Margin="0,12,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Window>

